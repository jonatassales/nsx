{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://langdrift.md/schemas/handoff/intent.schema.json",
	"title": "Recorded intent",
	"description": "The recorded intent (intent.json) that dft agent run applies, for \"console › intent     claude-sonnet-5-5 · effort medium · runtime.md revision 1\" and the HUMAN IN THE LOOP ticks. Planning always has a person in it.",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"ticket",
		"runtimeId",
		"revision",
		"model",
		"effort",
		"human",
		"status"
	],
	"properties": {
		"ticket": { "type": "string", "minLength": 1 },
		"runtimeId": { "type": "string", "minLength": 1 },
		"revision": { "type": "integer", "minimum": 1 },
		"model": { "type": "string", "minLength": 1 },
		"effort": { "enum": ["low", "medium", "high"] },
		"human": {
			"type": "object",
			"additionalProperties": false,
			"required": ["planning", "spec", "tickets", "implement", "review"],
			"properties": {
				"planning": { "const": true },
				"spec": { "type": "boolean" },
				"tickets": { "type": "boolean" },
				"implement": { "type": "boolean" },
				"review": { "type": "boolean" }
			}
		},
		"status": { "enum": ["proposed", "authorized"] }
	}
}
